{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(./mvnw spring-boot:run*)",
      "Bash(mvn spring-boot:run*)",
      "Bash(java -jar target/*)",
      "Bash(curl *localhost:8080/tickets*)",
      "Bash(curl *127.0.0.1:8080/tickets*)",
      "Bash(printenv*)",
      "Bash(env)"
