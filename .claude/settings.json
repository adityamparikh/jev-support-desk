{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(./mvnw *spring-boot:run*)",
      "Bash(mvn *spring-boot:run*)",
      "Bash(java -jar target/*)",
      "Bash(curl *:8080/tickets*)",
      "Bash(cat .env*)",
      "Bash(printenv*)",
      "Bash(env)"
    ],
    "deny": [
      "Read(./.idea/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Bash(*.idea/workspace.xml*)"
    ]
  }
}
