# Copy to .env (ignored by git) and fill in. Nothing reads .env automatically:
# load it with `set -a; source .env; set +a` before ./mvnw spring-boot:run, or paste the
# values into the IntelliJ run configuration's Environment variables.
# Use demo-only keys with a spend limit; every live run is billed.
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
# Optional; this is the default.
ANTHROPIC_MODEL=claude-sonnet-5
