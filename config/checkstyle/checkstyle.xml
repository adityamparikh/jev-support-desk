<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
	Spring Framework source style (the convention in CLAUDE.md), checked on every build.
	Excluded on purpose, because this demo does not follow them and CLAUDE.md does not ask for
	them: license headers, @author tags and Javadoc on every type, method and package; test
	class names ending in "Tests" (the suite uses "*Test"); and the ban on Mockito.when (the
	tests stub with when(..), not BDDMockito.given(..)).
-->
<module name="com.puppycrawl.tools.checkstyle.Checker">
	<module name="io.spring.javaformat.checkstyle.SpringChecks">
		<property name="headerType" value="none" />
		<property name="excludes"
			value="com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocPackageCheck,com.puppycrawl.tools.checkstyle.checks.javadoc.MissingJavadocPackageCheck,com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocTypeCheck,com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocVariableCheck,com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocMethodCheck,io.spring.javaformat.checkstyle.check.SpringTestFileNameCheck,com.puppycrawl.tools.checkstyle.checks.regexp.RegexpSinglelineJavaCheck" />
	</module>
</module>
